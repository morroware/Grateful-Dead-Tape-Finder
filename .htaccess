# Apache configuration for cPanel / shared hosting
#
# SETUP: Choose ONE of these approaches based on your cPanel:
#
#   Option A: cPanel "Setup Node.js App" (most common, uses Passenger)
#     - No .htaccess proxy needed — Passenger handles it
#     - Just set Application Root to the "server" folder
#     - Set Startup File to "app.js"
#
#   Option B: Manual Node.js + mod_proxy (less common on shared hosting)
#     - Uncomment the mod_proxy section below
#     - Start Node.js manually or via PM2

RewriteEngine On

# ── Option B: mod_proxy (uncomment if your host supports it) ──
# <IfModule mod_proxy.c>
#   ProxyPreserveHost On
#   RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]
# </IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent access to server directory and sensitive files
<FilesMatch "\.(env|sql|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 403 /server/
RedirectMatch 403 /node_modules/

# MIME types for ES modules
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
