# MySQL Database
# For cPanel: use the credentials from cPanel > MySQL Databases
# Database names on cPanel are usually prefixed: youruser_tapefinder
DB_HOST=localhost
DB_PORT=3306
DB_USER=tapefinder
DB_PASSWORD=your_password_here
DB_NAME=tapefinder

# Session
# A random secret string — the installer generates one automatically
SESSION_SECRET=change_this_to_a_random_64_char_string

# Server
PORT=3001

# CORS — set this to your actual domain, or * to allow any origin
# For cPanel: use your domain, e.g. https://yourdomain.com
# Using * works fine when frontend and backend are on the same server
FRONTEND_ORIGIN=*

# Cache TTLs (seconds)
SEARCH_CACHE_TTL=21600
SHOW_CACHE_TTL=86400

# Archive.org
ARCHIVE_API_BASE=https://archive.org

# Admin (used only during install to create the first admin user)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
