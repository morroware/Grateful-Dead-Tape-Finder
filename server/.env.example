# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=tapefinder
DB_PASSWORD=your_password_here
DB_NAME=tapefinder

# Session
SESSION_SECRET=change_this_to_a_random_64_char_string

# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:8080

# Cache TTLs (seconds)
SEARCH_CACHE_TTL=21600
SHOW_CACHE_TTL=86400

# Archive.org
ARCHIVE_API_BASE=https://archive.org

# Admin (set this to create the first admin user during install)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
